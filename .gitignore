# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# MLflow / artifacts (tracked via the MLflow server + DVC, not git)
mlruns/
mlartifacts/

# Serving build artifacts: the model bundle, ONNX exports and the prediction log
# are rebuilt/regenerated (not source), so keep them out of git.
models/artifacts/
serving/*.db
# Local SQLite MLflow store (the demo / offline runs create this).
mlflow.db
*.db-journal

# DVC-managed data (the .dvc pointer files ARE tracked; the data is not)
/data/raw/*
/data/interim/*
/data/processed/*
# ...but keep the DVC pointers, gitignore stubs, and dir placeholders
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/data/raw/*.dvc
!/data/interim/*.dvc
!/data/processed/*.dvc
*.parquet
*.csv
!tests/**/*.csv

# Local DVC remote storage
dvc-storage/

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
